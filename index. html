<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sparklex - AI for Law Students</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css">
  <style>
    .hero-bg { background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%); }
    .chat-bubble { max-width: 85%; }
    .message { animation: fadeIn 0.3s; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  </style>
</head>
<body class="bg-gray-50 font-sans">

  <!-- Navbar -->
  <nav class="bg-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-6 py-4 flex justify-between items-center">
      <div class="flex items-center space-x-3">
        <i class="fa-solid fa-gavel text-blue-600 text-3xl"></i>
        <h1 class="text-2xl font-bold text-blue-900">Sparklex</h1>
      </div>
      <div class="flex items-center gap-6">
        <span id="user-info" class="hidden text-sm font-medium text-gray-700"></span>
        <button onclick="logout()" id="logout-btn" class="hidden text-red-600 hover:text-red-700 font-medium">Logout</button>
        <button onclick="showLoginModal()" id="login-btn" class="text-blue-600 font-medium">Log in / Sign up</button>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero-bg text-white py-24">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h2 class="text-5xl md:text-6xl font-bold mb-6">Sparklex AI — Law Students' Companion</h2>
      <p class="text-xl md:text-2xl mb-10 max-w-2xl mx-auto">IRAC essays, case summaries, Nigerian law research, and exam prep. Start free today.</p>
      <button onclick="startFreeTrial()" class="bg-white text-blue-900 px-10 py-4 rounded-2xl text-lg font-semibold hover:bg-gray-100">Start 14-Day Free Trial</button>
    </div>
  </section>

  <!-- Chat Section -->
  <section class="py-20 bg-gray-100" id="chat-section">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-4xl font-bold text-center mb-8">Chat with Sparklex AI</h2>
      <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
        <div class="bg-blue-900 text-white px-6 py-4 flex justify-between items-center">
          <div class="flex items-center gap-3">
            <i class="fa-solid fa-gavel"></i>
            <div>
              <p class="font-semibold">Sparklex AI</p>
              <p class="text-xs opacity-75">Nigerian Law Specialist</p>
            </div>
          </div>
          <div id="usage-info" class="text-xs bg-white/20 px-4 py-1 rounded-full font-medium"></div>
        </div>

        <div id="chat-window" class="h-96 p-6 overflow-y-auto bg-gray-50 space-y-4"></div>

        <div class="p-5 border-t bg-white">
          <div class="flex gap-3">
            <input id="user-input" type="text" class="flex-1 border rounded-2xl px-6 py-4 focus:outline-none focus:border-blue-500" placeholder="E.g., Apply IRAC to the facts in Solomon v. Solomon...">
            <button onclick="sendMessage()" class="bg-blue-600 hover:bg-blue-700 text-white px-8 rounded-2xl transition">
              Send
            </button>
          </div>
          <p id="limit-warning" class="text-red-500 text-xs mt-2 text-center hidden">Limit reached. Upgrade your plan.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-6 text-center">
      <h2 class="text-4xl font-bold mb-4">Pricing Plans</h2>
      <p class="text-gray-600 mb-12">Start free. Scale as you study.</p>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        <div class="border rounded-3xl p-8">
          <h3 class="text-2xl font-bold">Free Trial</h3>
          <p class="text-6xl font-bold my-4">₦0</p>
          <p class="text-gray-500 mb-8">14 days • 50 messages</p>
          <button onclick="startFreeTrial()" class="w-full py-4 border-2 border-blue-600 text-blue-600 rounded-2xl font-semibold hover:bg-blue-50">Start Trial</button>
        </div>
        <div class="border-2 border-blue-600 rounded-3xl p-8 relative scale-105">
          <div class="absolute -top-5 left-1/2 -translate-x-1/2 bg-blue-600 text-white px-8 py-1 rounded-full text-sm font-medium">Popular</div>
          <h3 class="text-2xl font-bold">Basic</h3>
          <p class="text-6xl font-bold my-4">₦5,000</p>
          <p class="text-gray-500 mb-8">/month • 500 messages</p>
          <button onclick="subscribe('Basic')" class="w-full py-4 bg-blue-600 text-white rounded-2xl font-semibold hover:bg-blue-700">Subscribe</button>
        </div>
        <div class="border rounded-3xl p-8">
          <h3 class="text-2xl font-bold">Pro</h3>
          <p class="text-6xl font-bold my-4">₦10,000</p>
          <p class="text-gray-500 mb-8">/month • Unlimited</p>
          <button onclick="subscribe('Pro')" class="w-full py-4 border-2 border-blue-600 text-blue-600 rounded-2xl font-semibold hover:bg-blue-50">Subscribe</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Login Modal -->
  <div id="login-modal" class="hidden fixed inset-0 bg-black/60 flex items-center justify-center z-50">
    <div class="bg-white rounded-3xl p-8 w-full max-w-md mx-4">
      <h3 class="text-2xl font-bold mb-6">Sign up / Log in</h3>
      <input id="email" type="email" placeholder="your@email.com" class="w-full mb-4 px-5 py-4 border rounded-2xl">
      <button onclick="login()" class="w-full py-4 bg-blue-600 text-white rounded-2xl mb-4 font-semibold">Continue</button>
      <button onclick="hideLoginModal()" class="w-full py-4 text-gray-500">Cancel</button>
    </div>
  </div>

  <script>
    let currentUser = null;
    let messagesUsed = 0;
    let plan = "trial";
    let chatHistory = [];

    const systemPrompt = `You are Sparklex, a precise AI legal assistant for Nigerian law students. Use formal academic tone. Always structure problem questions with IRAC/CRAC. Cite Nigerian cases (e.g. Akintola v Adegbite, Olafisoye v FRN, Abacha v Fawehinmi) and statutes (1999 Constitution, Criminal Code Act, Evidence Act 2011). Explain clearly. Flag uncertainties. You are a study tool — never real legal advice.`;

    function initUser() {
      const saved = localStorage.getItem('sparklexUser');
      if (saved) {
        currentUser = JSON.parse(saved);
        plan = currentUser.plan || "trial";
        messagesUsed = currentUser.messagesUsed || 0;
        chatHistory = currentUser.chatHistory || [];
        document.getElementById('user-info').classList.remove('hidden');
        document.getElementById('user-info').innerHTML = `\( {currentUser.email} <span class="text-xs bg-blue-100 text-blue-700 px-2 py-1 rounded-full"> \){plan.toUpperCase()}</span>`;
        document.getElementById('login-btn').classList.add('hidden');
        document.getElementById('logout-btn').classList.remove('hidden');
        loadChatHistory();
      }
    }

    function login() {
      const email = document.getElementById('email').value.trim() || "student@sparklex.com";
      currentUser = { email, plan: "trial", messagesUsed: 0, chatHistory: [] };
      localStorage.setItem('sparklexUser', JSON.stringify(currentUser));
      hideLoginModal();
      initUser();
      addSystemMessage("Welcome to Sparklex! Ask me any legal question.");
    }

    function logout() {
      localStorage.removeItem('sparklexUser');
      location.reload();
    }

    function showLoginModal() { document.getElementById('login-modal').classList.remove('hidden'); }
    function hideLoginModal() { document.getElementById('login-modal').classList.add('hidden'); }

    function startFreeTrial() {
      if (!currentUser) showLoginModal();
      else alert("Free trial active. You have 50 messages remaining.");
    }

    function subscribe(newPlan) {
      if (!currentUser) { showLoginModal(); return; }
      plan = newPlan.toLowerCase();
      currentUser.plan = plan;
      localStorage.setItem('sparklexUser', JSON.stringify(currentUser));
      alert(`✅ Subscribed to ${newPlan} plan!`);
      initUser();
    }

    function updateUsage() {
      const limit = plan === "pro" ? "∞" : plan === "basic" ? 500 : 50;
      document.getElementById('usage-info').textContent = `\( {messagesUsed}/ \){limit}`;
      document.getElementById('limit-warning').classList.toggle('hidden', messagesUsed < (plan === "pro" ? 999999 : plan === "basic" ? 500 : 50));
    }

    function addSystemMessage(text) {
      const chat = document.getElementById('chat-window');
      const msg = document.createElement('div');
      msg.className = "chat-bubble bg-blue-100 p-5 rounded-3xl message";
      msg.innerHTML = text;
      chat.appendChild(msg);
      chat.scrollTop = chat.scrollHeight;
    }

    function sendMessage() {
      const input = document.getElementById('user-input');
      if (!input.value.trim() || !currentUser) return;

      const limit = plan === "pro" ? Infinity : plan === "basic" ? 500 : 50;
      if (messagesUsed >= limit) {
        alert("Message limit exceeded. Upgrade to continue.");
        return;
      }

      const chat = document.getElementById('chat-window');

      // User message
      const userMsg = document.createElement('div');
      userMsg.className = "chat-bubble bg-blue-600 text-white p-5 rounded-3xl ml-auto message";
      userMsg.textContent = input.value;
      chat.appendChild(userMsg);

      chatHistory.push({ type: "user", text: input.value });
      messagesUsed++;
      updateUsage();
      saveUserData();

      const query = input.value;
      input.value = '';

      // Simulated AI response (real version connects to LLM)
      setTimeout(() => {
        const aiMsg = document.createElement('div');
        aiMsg.className = "chat-bubble bg-gray-200 p-5 rounded-3xl message";
        aiMsg.innerHTML = `Issue: ${query}<br>Rule: Relevant provision of the 1999 Constitution / Case law...<br>Application: ...<br>Conclusion: ...<br><br>Need more details or citations?`;
        chat.appendChild(aiMsg);
        chat.scrollTop = chat.scrollHeight;
        chatHistory.push({ type: "ai", text: aiMsg.innerHTML });
        saveUserData();
      }, 800);
    }

    function saveUserData() {
      if (currentUser) {
        currentUser.messagesUsed = messagesUsed;
        currentUser.chatHistory = chatHistory;
        localStorage.setItem('sparklexUser', JSON.stringify(currentUser));
      }
    }

    function loadChatHistory() {
      const chat = document.getElementById('chat-window');
      chat.innerHTML = '';
      chatHistory.forEach(msg => {
        const div = document.createElement('div');
        div.className = msg.type === "user" ? "chat-bubble bg-blue-600 text-white p-5 rounded-3xl ml-auto message" : "chat-bubble bg-gray-200 p-5 rounded-3xl message";
        div.innerHTML = msg.text;
        chat.appendChild(div);
      });
      chat.scrollTop = chat.scrollHeight;
    }

    document.getElementById('user-input').addEventListener('keypress', e => { if (e.key === 'Enter') sendMessage(); });

    window.onload = () => {
      initUser();
      if (currentUser) updateUsage();
      else addSystemMessage("Sign up to start chatting with your AI law tutor.");
    };
  </script>
</body>
</html>
